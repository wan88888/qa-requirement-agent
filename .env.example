# 演示模式无需填写任何凭据。默认仅监听本机。
PORT=3210
DATA_DIR=./data

# 服务商：openai / gemini / deepseek / agnes / custom
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=
# 下列留空自动使用服务商预设；custom 必须填写 BASE_URL。
# 切换服务商时清空旧覆盖值，避免继续请求上一家服务。
LLM_API_MODE=
LLM_BASE_URL=
# json_schema / json_object / text（提示词请求 JSON，本地仍严格校验）
LLM_OUTPUT_FORMAT=
LLM_TIMEOUT_MS=120000

# 飞书扫码登录：首次配置应用凭据与回调地址，之后无需手工填写用户 Token。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:3210/api/auth/feishu/callback
# 可选：限制允许登录的企业 tenant_key，以逗号分隔。
FEISHU_ALLOWED_TENANT_KEYS=
# 旧版工作台已有记录时，填写原账号在此应用下的 open_id 以完成首次绑定。
FEISHU_WORKSPACE_OWNER_OPEN_ID=
# 留空使用 fetch-doc/create-doc 官方所需权限及 offline_access，详见设置页。
FEISHU_OAUTH_SCOPES=

# 飞书官方远程 MCP；浏览器工作台统一使用飞书登录。
FEISHU_MCP_URL=https://mcp.feishu.cn/mcp
FEISHU_USER_ACCESS_TOKEN=
# 若使用自有授权网关，可使用 Bearer token 替代上面的用户 token。
FEISHU_MCP_BEARER_TOKEN=
# 可选：仅允许读取这些租户域名，逗号分隔。
FEISHU_ALLOWED_HOSTS=

# 图像评审：Gemini/OpenAI 默认尝试开启；其他服务确认模型支持图片后设为 true。
# 文本模型设为 false；不支持图片时会明确记录未覆盖，不伪造视觉分析。
LLM_VISION_ENABLED=

# 可选：每百万 token 美元单价。留空用有效官方预设；其他模型缺省为未知。
LLM_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_CACHED_USD_PER_MILLION=
# 相同内容、模型和上下文的图像分析缓存，false 强制重新分析
VISUAL_CACHE_ENABLED=true
